# ===================================================================
# SCORA V0.1 — Environment Configuration Template
# Copy this file to `.env.local` for local development.
# ===================================================================

# -------------------------------------------------------------------
# 1. Database Connection Configuration (MySQL 8.0+ / MariaDB 10.6+)
# -------------------------------------------------------------------
# Database Host (Local or Remote Server)
DB_HOST=mysql-scorasql.alwaysdata.net

# Database Port (Default: 3306)
DB_PORT=3306

# Database User Credentials
DB_USER=scorasql
DB_PASSWORD=S123S123s123
DB_NAME=scorasql_1

# Connection Pool Settings
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=15000

# -------------------------------------------------------------------
# 2. Authentication & Session Security (JOSE JWT Token)
# -------------------------------------------------------------------
# Cryptographic secret for signing JWT session cookies (min 32 chars)
SESSION_SECRET=scora_super_secret_jwt_key_2026_production_secure_token_change_me

# Cookie max age in seconds (Default: 7 days = 604800)
SESSION_MAX_AGE=604800

# -------------------------------------------------------------------
# 3. AI & OpenRouter Engine Integration
# -------------------------------------------------------------------
# OpenRouter API Key for Claude 3.5 Sonnet / OpenAI evaluations
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# Default Model Identifier
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Site Metadata for OpenRouter headers
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_TITLE=SCORA

# -------------------------------------------------------------------
# 4. Platform Runtime Settings
# -------------------------------------------------------------------
NODE_ENV=development
PORT=3000

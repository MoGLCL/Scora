# Copy to .env.local and fill in real values.

# ─── Database (MySQL / MariaDB) ────────────────────────────────
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# ─── Auth ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_MAX_AGE_DAYS=7

# ─── Uploads ───────────────────────────────────────────────────
MAX_UPLOAD_BYTES=5242880

# OpenRouter key is encrypted before database storage with SESSION_SECRET.
# It may alternatively be supplied here; the admin panel never returns it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash:free
OPENROUTER_FALLBACK_MODELS=google/gemini-2.5-flash:free,meta-llama/llama-3.3-70b-instruct:free,qwen/qwen-2.5-coder-32b-instruct:free,deepseek/deepseek-r1:free,openai/gpt-4.1-mini
OPENROUTER_MAX_TOKENS=400
OPENROUTER_ASSISTANT_MAX_TOKENS=1200
OPENROUTER_SITE_TITLE=SCORA
APP_URL=

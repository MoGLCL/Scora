Project Scora {
  database_type: 'PostgreSQL'
  Note: 'MVP database draft for verified developer assessments and client discovery'
}

Table users {
  id uuid [pk]
  email varchar [not null, unique]
  role varchar [not null, note: 'developer | client | reviewer | admin']
  status varchar [not null]
  created_at timestamptz [not null]
}

Table developer_profiles {
  id uuid [pk]
  user_id uuid [not null, unique]
  display_name varchar [not null]
  headline varchar
  availability varchar
  passport_slug varchar [unique]
}

Table client_profiles {
  id uuid [pk]
  user_id uuid [not null, unique]
  organization_name varchar
  organization_size varchar
}

Table skills {
  id uuid [pk]
  slug varchar [not null, unique]
  name varchar [not null]
  category varchar [not null]
}

Table assessment_tracks {
  id uuid [pk]
  skill_id uuid [not null]
  name varchar [not null]
  level varchar [not null]
  version int [not null]
  status varchar [not null]
}

Table challenges {
  id uuid [pk]
  track_id uuid [not null]
  title varchar [not null]
  version int [not null]
  rubric_version varchar [not null]
  time_limit_minutes int [not null]
}

Table assessment_attempts {
  id uuid [pk]
  developer_id uuid [not null]
  track_id uuid [not null]
  challenge_id uuid [not null]
  status varchar [not null]
  started_at timestamptz
  submitted_at timestamptz
  assessment_version varchar [not null]
}

Table submissions {
  id uuid [pk]
  attempt_id uuid [not null]
  artifact_uri varchar [not null]
  commit_hash varchar
  language varchar [not null]
  created_at timestamptz [not null]
}

Table test_runs {
  id uuid [pk]
  submission_id uuid [not null]
  passed_count int [not null]
  failed_count int [not null]
  duration_ms int
  sandbox_policy_version varchar [not null]
}

Table quality_metrics {
  id uuid [pk]
  submission_id uuid [not null]
  analyzer varchar [not null]
  analyzer_version varchar [not null]
  maintainability_score decimal
  security_findings int
  test_coverage decimal
}

Table interview_sessions {
  id uuid [pk]
  attempt_id uuid [not null, unique]
  model_provider varchar [not null]
  model_version varchar [not null]
  rubric_version varchar [not null]
  understanding_score decimal
  confidence decimal
}

Table ownership_gate_results {
  id uuid [pk]
  attempt_id uuid [not null]
  gate_type varchar [not null, note: 'explanation | hidden_bug | live_change']
  passed boolean [not null]
  score decimal [not null]
  confidence decimal [not null]
  evidence_uri varchar
  rubric_version varchar [not null]
}

Table human_reviews {
  id uuid [pk]
  attempt_id uuid [not null]
  reviewer_user_id uuid [not null]
  decision varchar [not null]
  score_adjustment decimal
  reason_code varchar [not null]
  created_at timestamptz [not null]
}

Table trust_score_snapshots {
  id uuid [pk]
  developer_id uuid [not null]
  skill_id uuid [not null]
  attempt_id uuid [not null]
  skill_points int [not null]
  trust_score decimal [not null]
  confidence decimal [not null]
  scoring_version varchar [not null]
  calculated_at timestamptz [not null]
}

Table technical_reports {
  id uuid [pk]
  snapshot_id uuid [not null, unique]
  report_uri varchar [not null]
  visibility varchar [not null]
  generated_at timestamptz [not null]
}

Table opportunities {
  id uuid [pk]
  client_id uuid [not null]
  title varchar [not null]
  required_skill_id uuid [not null]
  status varchar [not null]
  created_at timestamptz [not null]
}

Table shortlists {
  id uuid [pk]
  opportunity_id uuid [not null]
  developer_id uuid [not null]
  created_at timestamptz [not null]

  indexes {
    (opportunity_id, developer_id) [unique]
  }
}

Ref: developer_profiles.user_id > users.id
Ref: client_profiles.user_id > users.id
Ref: assessment_tracks.skill_id > skills.id
Ref: challenges.track_id > assessment_tracks.id
Ref: assessment_attempts.developer_id > developer_profiles.id
Ref: assessment_attempts.track_id > assessment_tracks.id
Ref: assessment_attempts.challenge_id > challenges.id
Ref: submissions.attempt_id > assessment_attempts.id
Ref: test_runs.submission_id > submissions.id
Ref: quality_metrics.submission_id > submissions.id
Ref: interview_sessions.attempt_id > assessment_attempts.id
Ref: ownership_gate_results.attempt_id > assessment_attempts.id
Ref: human_reviews.attempt_id > assessment_attempts.id
Ref: human_reviews.reviewer_user_id > users.id
Ref: trust_score_snapshots.developer_id > developer_profiles.id
Ref: trust_score_snapshots.skill_id > skills.id
Ref: trust_score_snapshots.attempt_id > assessment_attempts.id
Ref: technical_reports.snapshot_id > trust_score_snapshots.id
Ref: opportunities.client_id > client_profiles.id
Ref: opportunities.required_skill_id > skills.id
Ref: shortlists.opportunity_id > opportunities.id
Ref: shortlists.developer_id > developer_profiles.id

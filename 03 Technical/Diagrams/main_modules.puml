@startuml
skinparam dpi 240
title Scora — Main Modules
top to bottom direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 16
skinparam defaultFontName "Readex Pro"
skinparam defaultFontColor #163126
skinparam ArrowColor #084C2D
skinparam componentBorderColor #16A34A
skinparam componentBackgroundColor #FFFFFF
skinparam packageBorderColor #16A34A
skinparam packageBackgroundColor #F0FAF3

package "Experience Layer" {
  [Developer Workspace] as dev
  [Client Discovery] as client
  [Reviewer Console] as reviewer
  [Admin & Governance] as admin
}

package "Core Product Modules" {
  [Identity & Access] as iam
  [Profiles & Skills] as profiles
  [Assessment Catalog] as catalog
  [Assessment Orchestration] as orchestration
  [AI Interview] as interview
  [Ownership Gates\nExplain • Debug • Modify] as gates
  [Human Review & Appeals] as review
  [Trust Engine] as trust
  [Reports & Passport] as reports
  [Discovery & Shortlist] as discovery
}

package "Platform Services" {
  [Secure Code Execution] as execution
  [Code Quality Analysis] as quality
  [Notifications] as notification
  [Audit & Observability] as audit
}

dev --> iam
client --> iam
reviewer --> iam
admin --> iam
iam --> profiles
dev --> orchestration
orchestration --> catalog
orchestration --> execution
execution --> quality
orchestration --> interview
quality --> trust
interview --> gates
quality --> gates
gates --> trust
reviewer --> review
review --> trust
trust --> reports
profiles --> reports
reports --> discovery
client --> discovery
discovery --> notification
admin --> audit
orchestration ..> audit
trust ..> audit
review ..> audit
@enduml

@startuml
skinparam dpi 240
title Scora — High-Level Architecture
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 16
skinparam defaultFontName "Readex Pro"
skinparam defaultFontColor #163126
skinparam ArrowColor #084C2D
skinparam ArrowThickness 1.4
skinparam packageStyle rectangle
skinparam packageBorderColor #16A34A
skinparam packageBackgroundColor #F0FAF3
skinparam componentBorderColor #16A34A
skinparam componentBackgroundColor #FFFFFF
skinparam databaseBorderColor #16A34A
skinparam databaseBackgroundColor #EDF8F1

actor Developer
actor Client
actor Reviewer
actor Admin

rectangle "User & Edge" as edge {
  component "Next.js Web App\nProfiles • Assessment • Search" as web
  component "API Gateway / BFF\nAuthZ • Validation • Rate Limits" as api
}

rectangle "Scora Platform Core" as core {
  component "Identity & Profiles" as identity
  component "Assessment Service\nFundamentals • AI-allowed task" as assessment
  component "AI Interview" as interview
  component "Ownership Gates\nExplain • Debug • Modify" as gates
  component "Human Review & Appeals" as review
  component "Trust Engine\nSP • Trust Score • Confidence" as trust
  component "Reports & Developer Passport" as reports
  component "Discovery & Shortlist" as discovery
  queue "Redis + BullMQ\nAssessment Jobs" as queue
}

rectangle "Isolated Execution Boundary" as execution {
  component "Runner Manager" as runner
  component "Ephemeral Sandbox\nNo network • CPU/RAM/time limits" as sandbox
  component "Tests + Static Analysis\nESLint • Semgrep" as analysis
}

rectangle "Data & Integrations" as data {
  database "PostgreSQL\nSystem of Record" as postgres
  storage "S3-compatible Storage\nCode • Logs • Reports" as s3
  component "LLM Provider API" as llm
  component "Identity Verification" as idp
  component "Notifications" as notify
  component "OpenTelemetry\nLogs • Metrics • Traces" as obs
}

Developer --> web
Client --> web
Reviewer --> web
Admin --> web
web --> api
api --> identity
api --> assessment
api --> discovery
assessment --> queue : submit job
queue --> runner
runner --> sandbox
sandbox --> analysis
analysis --> assessment : structured evidence
assessment --> interview
interview --> llm
assessment --> review : low confidence / appeal
interview --> gates
assessment --> gates
gates --> trust
review --> trust
trust --> reports
reports --> discovery
identity --> idp
api --> notify
identity --> postgres
assessment --> postgres
trust --> postgres
reports --> postgres
assessment --> s3
runner --> s3
api ..> obs
runner ..> obs
trust ..> obs
@enduml
